rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function isBootstrappedSuperAdmin() {
      return isVerified() && request.auth.token.email == 'prachiamahajan192008@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedSuperAdmin() ||
        (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isCrmAdmin() {
      return isAdmin() || (isVerified() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userRole() == 'CRM_ADMIN');
    }

    function isCrmStaff() {
      return isAdmin() || (isVerified() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (userRole() == 'CRM_ADMIN' || userRole() == 'CRM_EMPLOYEE'));
    }

    // 3. Entity Validation Blueprints
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 180 &&
        data.grantedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'department', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role in ['SUPER_ADMIN', 'CRM_ADMIN', 'CRM_EMPLOYEE', 'WEBSITE_VISITOR'] &&
        (!('department' in data) || (data.department is string && data.department.size() <= 80)) &&
        data.status in ['active', 'suspended'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'phone', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 180 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        data.updatedAt is timestamp;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['ownerId', 'botType', 'title', 'status', 'unansweredCount', 'messageCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'botType', 'title', 'status', 'unansweredCount', 'messageCount', 'lastMessagePreview', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.botType in ['website', 'crm'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.status in ['active', 'escalated', 'resolved'] &&
        data.unansweredCount is int && data.unansweredCount >= 0 &&
        data.messageCount is int && data.messageCount >= 0 &&
        (!('lastMessagePreview' in data) || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['ownerId', 'sender', 'text', 'escalated', 'feedback', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'sender', 'text', 'escalated', 'feedback', 'sourceRefs', 'hasChart', 'createdAt']) &&
        isValidId(data.ownerId) &&
        data.sender in ['user', 'assistant'] &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 12000 &&
        data.escalated is bool &&
        data.feedback in ['none', 'up', 'down'] &&
        (!('sourceRefs' in data) || (data.sourceRefs is string && data.sourceRefs.size() <= 1000)) &&
        (!('hasChart' in data) || data.hasChart is bool) &&
        data.createdAt is timestamp;
    }

    function isValidKnowledgeDocument(data) {
      return data.keys().hasAll(['botType', 'title', 'category', 'sourceType', 'content', 'chunkCount', 'active', 'processingStatus', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['botType', 'title', 'category', 'sourceType', 'content', 'chunkCount', 'active', 'processingStatus', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.botType in ['website', 'crm'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.sourceType in ['pdf', 'docx', 'txt', 'custom'] &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 80000 &&
        data.chunkCount is int && data.chunkCount >= 0 &&
        data.active is bool &&
        data.processingStatus in ['indexed', 'processing', 'disabled'] &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTrainingQuestion(data) {
      return data.keys().hasAll(['botType', 'category', 'question', 'answer', 'active', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['botType', 'category', 'question', 'answer', 'intent', 'active', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.botType in ['website', 'crm'] &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.question is string && data.question.size() >= 2 && data.question.size() <= 500 &&
        data.answer is string && data.answer.size() >= 2 && data.answer.size() <= 4000 &&
        (!('intent' in data) || (data.intent is string && data.intent.size() <= 80)) &&
        data.active is bool &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTrainingCategory(data) {
      return data.keys().hasAll(['botType', 'name', 'createdAt']) &&
        data.keys().hasOnly(['botType', 'name', 'description', 'createdAt']) &&
        data.botType in ['website', 'crm'] &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
        data.createdAt is timestamp;
    }

    function isValidEscalation(data) {
      return data.keys().hasAll(['ownerId', 'botType', 'conversationId', 'question', 'channel', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'botType', 'conversationId', 'question', 'channel', 'status', 'notes', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.botType in ['website', 'crm'] &&
        isValidId(data.conversationId) &&
        data.question is string && data.question.size() >= 1 && data.question.size() <= 1000 &&
        data.channel in ['auto', 'call', 'whatsapp', 'email'] &&
        data.status in ['open', 'in_review', 'resolved'] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBotConfig(data) {
      return data.keys().hasAll(['botType', 'botName', 'welcomeMessage', 'systemInstructions', 'model', 'temperature', 'maxResponseLength', 'enabled', 'updatedAt']) &&
        data.keys().hasOnly(['botType', 'botName', 'welcomeMessage', 'systemInstructions', 'model', 'temperature', 'maxResponseLength', 'knowledgeBaseId', 'crmDataMode', 'enabled', 'updatedAt']) &&
        data.botType in ['website', 'crm'] &&
        data.botName is string && data.botName.size() >= 1 && data.botName.size() <= 80 &&
        data.welcomeMessage is string && data.welcomeMessage.size() >= 1 && data.welcomeMessage.size() <= 600 &&
        data.systemInstructions is string && data.systemInstructions.size() >= 1 && data.systemInstructions.size() <= 4000 &&
        data.model is string && data.model.size() >= 1 && data.model.size() <= 80 &&
        data.temperature is number && data.temperature >= 0 && data.temperature <= 2 &&
        data.maxResponseLength is int && data.maxResponseLength >= 100 && data.maxResponseLength <= 8000 &&
        (!('knowledgeBaseId' in data) || (data.knowledgeBaseId is string && data.knowledgeBaseId.size() <= 80)) &&
        (!('crmDataMode' in data) || data.crmDataMode in ['demo_ro', 'production_ro']) &&
        data.enabled is bool &&
        data.updatedAt is timestamp;
    }

    function isValidSupportConfig(data) {
      return data.keys().hasAll(['companyName', 'supportPhone', 'whatsappNumber', 'supportEmail', 'updatedAt']) &&
        data.keys().hasOnly(['companyName', 'supportPhone', 'whatsappNumber', 'supportEmail', 'headOffice', 'branchOffice', 'contactUrl', 'updatedAt']) &&
        data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 120 &&
        data.supportPhone is string && data.supportPhone.size() >= 6 && data.supportPhone.size() <= 30 &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 6 && data.whatsappNumber.size() <= 30 &&
        data.supportEmail is string && data.supportEmail.size() >= 3 && data.supportEmail.size() <= 160 &&
        (!('headOffice' in data) || (data.headOffice is string && data.headOffice.size() <= 300)) &&
        (!('branchOffice' in data) || (data.branchOffice is string && data.branchOffice.size() <= 300)) &&
        (!('contactUrl' in data) || (data.contactUrl is string && data.contactUrl.size() <= 250)) &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'action', 'target', 'createdAt']) &&
        data.keys().hasOnly(['actorUid', 'action', 'target', 'detail', 'createdAt']) &&
        isValidId(data.actorUid) &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 100 &&
        data.target is string && data.target.size() >= 1 && data.target.size() <= 180 &&
        (!('detail' in data) || (data.detail is string && data.detail.size() <= 600)) &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules
    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isBootstrappedSuperAdmin();
      allow create: if isBootstrappedSuperAdmin() && isValidId(uid) && isValidAdminRecord(incoming()) && incoming().uid == uid && incoming().grantedAt == request.time;
      allow update, delete: if isBootstrappedSuperAdmin() && isValidId(uid);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isBootstrappedSuperAdmin() || (isVerified() && existing().uid == request.auth.uid);
      allow create: if isVerified() && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (userId == request.auth.uid && incoming().role == 'WEBSITE_VISITOR' && incoming().status == 'active') ||
          (userId == request.auth.uid && isBootstrappedSuperAdmin() && incoming().role == 'SUPER_ADMIN') ||
          isAdmin()
        );
      allow update: if isVerified() && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(userId);

      match /private/{docId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isBootstrappedSuperAdmin() || (isVerified() && existing().uid == request.auth.uid);
        allow create: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(docId) && isValidUserPrivateInfo(incoming()) && incoming().uid == userId && incoming().updatedAt == request.time;
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(docId) && isValidUserPrivateInfo(incoming()) && incoming().uid == existing().uid && incoming().updatedAt == request.time;
        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }
    }

    match /website_conversations/{conversationId} {
      allow get: if isValidId(conversationId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
      allow list: if isBootstrappedSuperAdmin() || (isVerified() && existing().ownerId == request.auth.uid);
      allow create: if isVerified() && isValidId(conversationId) && isValidConversation(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().botType == 'website' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(conversationId) && isValidConversation(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().botType == 'website' &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && existing().status != 'resolved' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'unansweredCount', 'messageCount', 'lastMessagePreview', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(conversationId);

      match /website_messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
        allow list: if isBootstrappedSuperAdmin() || (isVerified() && existing().ownerId == request.auth.uid);
        allow create: if isVerified() && isValidId(conversationId) && isValidId(messageId) && isValidChatMessage(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/website_conversations/$(conversationId)) &&
          get(/databases/$(database)/documents/website_conversations/$(conversationId)).data.ownerId == request.auth.uid;
        allow update: if isVerified() && isValidId(conversationId) && isValidId(messageId) && isValidChatMessage(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && (
            isAdmin() ||
            (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['feedback']))
          );
        allow delete: if isAdmin() && isValidId(conversationId) && isValidId(messageId);
      }
    }

    match /crm_conversations/{conversationId} {
      allow get: if isValidId(conversationId) && (isCrmAdmin() || (isCrmStaff() && existing().ownerId == request.auth.uid));
      allow list: if isBootstrappedSuperAdmin() || (isVerified() && existing().ownerId == request.auth.uid);
      allow create: if isCrmStaff() && isValidId(conversationId) && isValidConversation(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().botType == 'crm' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isCrmStaff() && isValidId(conversationId) && isValidConversation(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().botType == 'crm' &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isCrmAdmin() ||
          (existing().ownerId == request.auth.uid && existing().status != 'resolved' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'unansweredCount', 'messageCount', 'lastMessagePreview', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(conversationId);

      match /crm_messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) && (isCrmAdmin() || (isCrmStaff() && existing().ownerId == request.auth.uid));
        allow list: if isBootstrappedSuperAdmin() || (isVerified() && existing().ownerId == request.auth.uid);
        allow create: if isCrmStaff() && isValidId(conversationId) && isValidId(messageId) && isValidChatMessage(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/crm_conversations/$(conversationId)) &&
          get(/databases/$(database)/documents/crm_conversations/$(conversationId)).data.ownerId == request.auth.uid;
        allow update: if isCrmStaff() && isValidId(conversationId) && isValidId(messageId) && isValidChatMessage(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && (
            isCrmAdmin() ||
            (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['feedback']))
          );
        allow delete: if isAdmin() && isValidId(conversationId) && isValidId(messageId);
      }
    }

    match /website_knowledge_base/{docId} {
      allow get: if isValidId(docId) && isAdmin();
      allow list: if isBootstrappedSuperAdmin();
      allow create: if isAdmin() && isValidId(docId) && isValidKnowledgeDocument(incoming()) &&
        incoming().botType == 'website' &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(docId) && isValidKnowledgeDocument(incoming()) &&
        incoming().botType == 'website' &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(docId);
    }

    match /crm_knowledge_base/{docId} {
      allow get: if isValidId(docId) && isCrmStaff();
      allow list: if isBootstrappedSuperAdmin();
      allow create: if isCrmAdmin() && isValidId(docId) && isValidKnowledgeDocument(incoming()) &&
        incoming().botType == 'crm' &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isCrmAdmin() && isValidId(docId) && isValidKnowledgeDocument(incoming()) &&
        incoming().botType == 'crm' &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isCrmAdmin() && isValidId(docId);
    }

    match /training_questions/{questionId} {
      allow get: if isValidId(questionId) && (isAdmin() || (isCrmStaff() && existing().botType == 'crm'));
      allow list: if isBootstrappedSuperAdmin() || (isVerified() && existing().createdBy == request.auth.uid);
      allow create: if isValidId(questionId) && isValidTrainingQuestion(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() || (isCrmAdmin() && incoming().botType == 'crm')
        );
      allow update: if isValidId(questionId) && isValidTrainingQuestion(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (isCrmAdmin() && incoming().botType == 'crm' && existing().botType == 'crm')
        );
      allow delete: if isValidId(questionId) && (isAdmin() || (isCrmAdmin() && existing().botType == 'crm'));
    }

    match /training_categories/{categoryId} {
      allow get: if isValidId(categoryId) && isCrmStaff();
      allow list: if isBootstrappedSuperAdmin();
      allow create: if isValidId(categoryId) && isValidTrainingCategory(incoming()) &&
        incoming().createdAt == request.time && (
          isAdmin() || (isCrmAdmin() && incoming().botType == 'crm')
        );
      allow update: if isValidId(categoryId) && isValidTrainingCategory(incoming()) &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() || (isCrmAdmin() && incoming().botType == 'crm')
        );
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /escalations/{escalationId} {
      allow get: if isValidId(escalationId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
      allow list: if isBootstrappedSuperAdmin() || (isVerified() && existing().ownerId == request.auth.uid);
      allow create: if isVerified() && isValidId(escalationId) && isValidEscalation(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(escalationId) && isValidEscalation(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && existing().status != 'resolved' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['channel', 'notes', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(escalationId);
    }

    match /bot_settings/{botId} {
      allow get: if isValidId(botId) && isAdmin();
      allow list: if isBootstrappedSuperAdmin();
      allow create: if isAdmin() && isValidId(botId) && isValidBotConfig(incoming()) && incoming().botType == botId && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(botId) && isValidBotConfig(incoming()) && incoming().botType == existing().botType && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /support_settings/{settingId} {
      allow get: if isValidId(settingId) && isAdmin();
      allow list: if isBootstrappedSuperAdmin();
      allow create, update: if isAdmin() && isValidId(settingId) && isValidSupportConfig(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isBootstrappedSuperAdmin();
      allow create: if isVerified() && isValidId(logId) && isValidAuditLog(incoming()) &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
